{
  "name": "masum-galaxy-terminal-x",
  "displayName": "Masum Galaxy Terminal X",
  "description": "Galaxy-themed native PowerShell terminal with bordered prompts, command favorites, and theme gallery.",
  "version": "1.9.0",
  "publisher": "gitwithmasum",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "keywords": [
    "terminal",
    "commands",
    "galaxy",
    "productivity",
    "powershell",
    "terminal prompt",
    "terminal theme",
    "circuit",
    "command launcher"
  ],
  "activationEvents": [
    "onCommand:galaxyTerminal.openDashboard",
    "onCommand:galaxyTerminal.newTerminal",
    "onCommand:galaxyTerminal.runSavedCommand",
    "onCommand:galaxyTerminal.stageFromHistory",
    "onCommand:galaxyTerminal.applyTerminalColors",
    "onCommand:galaxyTerminal.restoreTerminalColors"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "galaxyTerminal.openDashboard",
        "title": "Galaxy Terminal X: Open Dashboard",
        "icon": "$(terminal)"
      },
      {
        "command": "galaxyTerminal.newTerminal",
        "title": "Galaxy Terminal X: New Terminal"
      },
      {
        "command": "galaxyTerminal.runSavedCommand",
        "title": "Galaxy Terminal X: Run Saved Command"
      },
      {
        "command": "galaxyTerminal.stageFromHistory",
        "title": "Galaxy Terminal X: Stage From History"
      },
      {
        "command": "galaxyTerminal.applyTerminalColors",
        "title": "Galaxy Terminal X: Apply Native Terminal Colors"
      },
      {
        "command": "galaxyTerminal.restoreTerminalColors",
        "title": "Galaxy Terminal X: Restore Previous Terminal Colors"
      }
    ],
    "configuration": {
      "title": "Masum Galaxy Terminal X",
      "properties": {
        "galaxyTerminal.theme": {
          "type": "string",
          "default": "blue-circuit",
          "enum": [
            "blue-circuit",
            "black-gold",
            "galaxy-purple",
            "minimal-dark"
          ],
          "description": "Dashboard theme; more themes can be added later."
        },
        "galaxyTerminal.savedCommands": {
          "type": "array",
          "default": [
            {
              "label": "Git status",
              "command": "git status"
            },
            {
              "label": "Install dependencies",
              "command": "npm install"
            },
            {
              "label": "Run tests",
              "command": "npm test"
            },
            {
              "label": "Run dev server",
              "command": "npm run dev"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "label",
              "command"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              }
            }
          },
          "description": "Quick commands for your terminal. Review commands before running."
        },
        "galaxyTerminal.enableGalaxyPrompt": {
          "type": "boolean",
          "default": true,
          "description": "On Windows, launch a dedicated PowerShell terminal with a Galaxy-themed startup banner and prompt. Does not alter your PowerShell profile."
        },
        "galaxyTerminal.shellProfile": {
          "type": "string",
          "default": "powershell",
          "enum": [
            "powershell",
            "cmd",
            "default"
          ],
          "description": "Choose shell for new Galaxy terminals. CMD supported on Windows; default uses VS Code's selected shell."
        },
        "galaxyTerminal.promptStyle": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "compact"
          ],
          "description": "Prompt layout for new Galaxy PowerShell sessions."
        },
        "galaxyTerminal.backgroundMode": {
          "type": "string",
          "default": "circuit",
          "enum": [
            "circuit",
            "original"
          ],
          "description": "Blue Circuit background asset: bundled SVG, or original PNG copied to media/themes/blue-circuit-bg.png."
        },
        "galaxyTerminal.showGitBranch": {
          "type": "boolean",
          "default": false,
          "description": "Show Git branch in Galaxy PowerShell prompt when inside a Git repository. Enabled for newly created terminals."
        },
        "galaxyTerminal.showClock": {
          "type": "boolean",
          "default": true,
          "description": "Show current time in the classic Galaxy PowerShell prompt for newly created terminals."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "package": "npm run compile && vsce package --no-dependencies",
    "verify:vsix": "node scripts/verify-vsix.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3",
    "@vscode/vsce": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitwithmasum/Masum-Galaxy-Terminal-X.git"
  },
  "bugs": {
    "url": "https://github.com/gitwithmasum/Masum-Galaxy-Terminal-X/issues"
  },
  "homepage": "https://github.com/gitwithmasum/Masum-Galaxy-Terminal-X#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#061632",
    "theme": "dark"
  }
}
